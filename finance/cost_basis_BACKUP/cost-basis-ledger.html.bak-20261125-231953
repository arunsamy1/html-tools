      .then(function(){ status("CSV saved."); setTimeout(function(){ if (ready) status(""); }, 2500); })
      ["catch"](function(e){
        if (!e || e.code !== "declined"){
          status("Couldn't save the CSV." + (e && e.message ? " " + e.message : ""), true);
          setTimeout(function(){ if (ready) status(""); }, 4000);
        }
      })
      ["finally"](function(){ b.disabled = false; });
