  /* ---------- CSV import ---------- */
  var pending = null;

  function parseCSV(text){
    var rows = [], row = [], cur = "", q = false;
    text = String(text).replace(/^﻿/, "");
    for (var i = 0; i < text.length; i++){
      var c = text.charAt(i);
      if (q){
        if (c === '"'){
          if (text.charAt(i + 1) === '"'){ cur += '"'; i++; }
          else { q = false; }
        } else { cur += c; }
      }
      else if (c === '"'){ q = true; }
      else if (c === ","){ row.push(cur); cur = ""; }
      else if (c === "\n"){ row.push(cur); rows.push(row); row = []; cur = ""; }
      else if (c !== "\r"){ cur += c; }
    }
    row.push(cur); rows.push(row);
    return rows.filter(function(r){
      return r.some(function(v){ return String(v).trim() !== ""; });
    });
  }

  var HEAD = {
    symbol: ["symbol", "ticker"],
    date:   ["buydate", "date"],
    shares: ["shares", "quantity", "qty"],
    cost:   ["costpershare", "costshare", "costperunit", "price"]
  };
  var LABEL = { symbol:"Symbol", date:"Buy Date", shares:"Shares", cost:"Cost per Share" };

  function normKey(s){ return String(s).toLowerCase().replace(/[^a-z0-9]/g, ""); }
  function pad2(n){ n = String(n); return n.length < 2 ? "0" + n : n; }

  function parseNum(v){
    var s = String(v == null ? "" : v).replace(/[$,\s]/g, "");
    return s === "" ? NaN : parseFloat(s);
  }
  function parseDate(v){
    var s = String(v == null ? "" : v).trim();
    if (s === "" || s === "—" || s === "-") return "";
    var y, mo, d, m = /^(\d{4})-(\d{1,2})-(\d{1,2})$/.exec(s);
    if (m){ y = +m[1]; mo = +m[2]; d = +m[3]; }
    else {
      m = /^(\d{1,2})[\/.](\d{1,2})[\/.](\d{4})$/.exec(s);
      if (!m) return null;
      mo = +m[1]; d = +m[2]; y = +m[3];
    }
    if (mo < 1 || mo > 12 || d < 1 || d > 31) return null;
    return y + "-" + pad2(mo) + "-" + pad2(d);
  }

  function mapCSV(text){
    var rows = parseCSV(text);
    if (!rows.length) return { fatal:"That file has no rows." };
    var head = rows[0].map(normKey), idx = {};
    Object.keys(HEAD).forEach(function(k){
      idx[k] = -1;
      HEAD[k].forEach(function(name){
        if (idx[k] === -1) idx[k] = head.indexOf(name);
      });
    });
    var missing = ["symbol", "shares", "cost"].filter(function(k){ return idx[k] === -1; });
    if (missing.length){
      return { fatal:"The header row is missing " + missing.map(function(k){
        return LABEL[k];
      }).join(" and ") + ". It needs Symbol, Buy Date, Shares and Cost per Share." };
    }
    var ok = [], bad = [];
    for (var r = 1; r < rows.length; r++){
      var row = rows[r];
      var sym = String(row[idx.symbol] == null ? "" : row[idx.symbol]).trim().toUpperCase();
      if (sym === "" || sym === "TOTAL") continue;
      var sh = parseNum(row[idx.shares]);
      var cs = parseNum(row[idx.cost]);
      var dt = idx.date === -1 ? "" : parseDate(row[idx.date]);
      var why = null;
      if (!/^[A-Z0-9.\-]{1,12}$/.test(sym)) why = "“" + sym + "” isn't a usable symbol";
      else if (dt === null) why = "couldn't read the date “" +
        String(row[idx.date]).trim() + "”";
      else if (!isFinite(sh) || sh <= 0) why = "shares must be a number above zero";
      else if (!isFinite(cs) || cs < 0) why = "cost per share must be zero or more";
      if (why) bad.push({ line:r + 1, why:why });
      else ok.push({ symbol:sym, date:dt, shares:sh, cost:cs });
    }
    return { ok:ok, bad:bad };
  }

  function prog(msg, kind){
    var el = $("imp-progress");
    if (!msg){ el.hidden = true; return; }
    el.textContent = msg;
    el.className = "note" + (kind ? " " + kind : "");
    el.hidden = false;
  }

  function showReport(res){
    var box = $("imp-report");
    box.textContent = "";
    pending = null;
    prog("");
    var p = document.createElement("p");
    if (res.fatal){
      p.className = "err";
      p.textContent = res.fatal;
      box.appendChild(p);
      box.hidden = false;
      $("imp-actions").hidden = true;
      return;
    }
    p.className = "note";
    p.textContent = res.ok.length
      ? "Ready to import " + res.ok.length + (res.ok.length === 1 ? " lot" : " lots") +
        (res.bad.length ? ", skipping " + res.bad.length + "." : ".")
      : "Nothing importable in that file.";
    box.appendChild(p);
    if (res.bad.length){
      var ul = document.createElement("ul");
      ul.className = "probs";
      res.bad.slice(0, 6).forEach(function(b){
        var li = document.createElement("li");
        li.textContent = "Line " + b.line + ": " + b.why;
        ul.appendChild(li);
      });
      if (res.bad.length > 6){
        var more = document.createElement("li");
        more.textContent = "…and " + (res.bad.length - 6) + " more";
        ul.appendChild(more);
      }
      box.appendChild(ul);
    }
    box.hidden = false;
    pending = res.ok.length ? res.ok : null;
    $("imp-actions").hidden = !pending;
  }

  function readFile(file){
    if (!file) return;
    if (file.size > 4194304){
      showReport({ fatal:"That file is larger than 4 MB." });
      return;
    }
    var fr = new FileReader();
    fr.onload = function(){ showReport(mapCSV(String(fr.result))); };
    fr.onerror = function(){ showReport({ fatal:"Couldn't read that file." }); };
    fr.readAsText(file);
  }

  function clearImport(){
    pending = null;
    $("file").value = "";
    $("imp-report").hidden = true;
    $("imp-report").textContent = "";
    $("imp-actions").hidden = true;
    $("imp-replace").checked = false;
  }

  function attempt(fn){
    return fn()["catch"](function(e){
      var c = e && e.code;
      if (c === "unavailable" || c === "resource_exhausted"){
        return new Promise(function(res){
          setTimeout(res, 400 + Math.random() * 500);
        }).then(fn);
      }
      throw e;
    });
  }
  function runQueue(tasks, conc, onStep){
    return new Promise(function(resolve){
      if (!tasks.length){ resolve(0); return; }
      var next = 0, active = 0, done = 0, fails = 0;
      function pump(){
        if (next >= tasks.length && active === 0){ resolve(fails); return; }
        while (active < conc && next < tasks.length){
          active++;
          attempt(tasks[next++])["catch"](function(){ fails++; })
            .then(function(){
              active--; done++;
              if (onStep) onStep(done, tasks.length);
              pump();
            });
        }
      }
      pump();
    });
  }

  $("file").addEventListener("change", function(){
    readFile($("file").files && $("file").files[0]);
  });
  (function(){
    var d = $("drop");
    ["dragenter", "dragover"].forEach(function(ev){
      d.addEventListener(ev, function(e){ e.preventDefault(); d.classList.add("over"); });
    });
    ["dragleave", "dragend"].forEach(function(ev){
      d.addEventListener(ev, function(){ d.classList.remove("over"); });
    });
    d.addEventListener("drop", function(e){
      e.preventDefault();
      d.classList.remove("over");
      readFile(e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]);
    });
  })();
  $("imp-cancel").addEventListener("click", function(){ clearImport(); prog(""); });

  $("imp-go").addEventListener("click", function(){
    if (!pending) return;
    if (!db){ prog("Storage isn't available in this view, so nothing was imported.", "err"); return; }
    var rows = pending;
    var replace = $("imp-replace").checked;
    var oldIds = replace ? lots.map(function(l){ return l.id; }) : [];
    var go = $("imp-go"), ca = $("imp-cancel");
    go.disabled = true; ca.disabled = true;
    prog("Importing 0 of " + rows.length + "…");

    var adds = rows.map(function(r){
      return function(){
        return db.collection(COL).add({
          symbol:r.symbol, date:r.date, shares:r.shares, cost:r.cost, created:Date.now()
        });
      };
    });

    /* Add first, remove the old rows only once something landed, so a failed
       import can never leave the ledger empty. */
    runQueue(adds, 4, function(d, t){
      prog("Importing " + d + " of " + t + "…");
    }).then(function(addFails){
      var added = rows.length - addFails;
      if (!replace || !added) return [addFails, 0];
      prog("Imported " + added + ". Removing " + oldIds.length + " earlier lots…");
      var dels = oldIds.map(function(id){
        return function(){ return db.collection(COL).doc(id).delete(); };
      });
      return runQueue(dels, 4).then(function(delFails){ return [addFails, delFails]; });
    }).then(function(res){
      var addFails = res[0], delFails = res[1];
      var added = rows.length - addFails;
      var msg = "Imported " + added + " of " + rows.length +
        (rows.length === 1 ? " lot." : " lots.");
      if (replace && added) msg += " Replaced " + (oldIds.length - delFails) +
        " earlier " + (oldIds.length - delFails === 1 ? "lot." : "lots.");
      if (addFails) msg += " " + addFails + " row" + (addFails === 1 ? "" : "s") +
        " couldn't be saved.";
      if (delFails) msg += " " + delFails + " earlier " +
        (delFails === 1 ? "lot" : "lots") + " couldn't be removed.";
      if (replace && !added) msg += " Nothing was removed.";
      clearFilter();
      clearImport();
      prog(msg, (addFails || delFails) ? "err" : "good");
      go.disabled = false; ca.disabled = false;
    });
  });

  /* ---------- theme ---------- */
  var THEME_KEY = "cost-basis-ledger/theme";
  var THEMES = ["system", "light", "dark"];
  var LABELS = { system:"Theme: System", light:"Theme: White", dark:"Theme: Dark" };
  var theme = "system";
