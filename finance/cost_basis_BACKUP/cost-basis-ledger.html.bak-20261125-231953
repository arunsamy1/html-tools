  /* ---------- CSV ---------- */
  function csv(){
    var q = function(v){
      var s = String(v == null ? "" : v);
      return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
    };
    var rows = [["Symbol","Buy Date","Shares","Cost per Share"]];
    sorted(lots, { k:"symbol", dir:"asc" }, function(l,k){
      return k === "symbol" ? String(l.symbol || "") : String(l.date || "");
    }).forEach(function(l){
      rows.push([l.symbol || "", fmtDate(l.date), num(l.shares), num(l.cost)]);
    });
    return rows.map(function(r){ return r.map(q).join(","); }).join("\r\n");
  }

  $("btn-csv").addEventListener("click", function(){
    if (!downloads) return;
    var b = $("btn-csv");
    b.disabled = true;
