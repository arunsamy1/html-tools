<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<script>
/* Set the saved theme before first paint, so the page never flashes the wrong one. */
try {
  var t = localStorage.getItem("cost-basis-ledger/theme");
  if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
} catch (e) {}
</script>
<title>Cost Basis Ledger</title>
<style>
:root{color-scheme:light}
/* Page-wide text scale. Everything below is sized in rem, so this one
   number scales the whole page and still respects a browser font setting. */
html{font-size:115%}
html,body{margin:0;padding:0}
body{font:.875rem/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}
img{max-width:100%}
[hidden]{display:none!important}
</style>
<style>
/* Layout: a statement — totals band, positions roll-up, then the lot ledger with its entry form. */
:root{
  --bg:#ffffff; --surface:#ffffff; --surface-2:#eff3f3; --surface-3:#e3e8e9;
  --field:#f5f8f8;
  --fg:#152027; --fg-dim:#586b74; --fg-faint:#80949c;
  --line:#d4dcde; --line-soft:#e4eaeb;
  --accent:#0d5c69; --accent-ink:#0a4753; --accent-soft:#dfeef0;
  --danger:#9c3024; --danger-soft:#fbe8e5;
  --btn-fg:#ffffff;
  --font-display:"IBM Plex Serif",Georgia,"Times New Roman",serif;
  --font-body:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
  --font-mono:"IBM Plex Mono",ui-monospace,"SF Mono",Menlo,Consolas,monospace;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0e1418; --surface:#161e23; --surface-2:#1d272d; --surface-3:#253138;
  --field:#0a1014;
  --fg:#e7eef1; --fg-dim:#97a9b3; --fg-faint:#6d808b;
  --line:#2a363d; --line-soft:#222d33;
  --accent:#58c3bc; --accent-ink:#8ad8d2; --accent-soft:#13302f;
  --danger:#e0877a; --danger-soft:#34201d;
  --btn-fg:#0e1418;
  color-scheme:dark;
}}
:root[data-theme="dark"]{
  --bg:#0e1418; --surface:#161e23; --surface-2:#1d272d; --surface-3:#253138;
  --field:#0a1014;
  --fg:#e7eef1; --fg-dim:#97a9b3; --fg-faint:#6d808b;
  --line:#2a363d; --line-soft:#222d33;
  --accent:#58c3bc; --accent-ink:#8ad8d2; --accent-soft:#13302f;
  --danger:#e0877a; --danger-soft:#34201d;
  --btn-fg:#0e1418;
  color-scheme:dark;
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font-family:var(--font-body);line-height:1.5;
  -webkit-font-smoothing:antialiased}
.wrap{max-width:1180px;margin:0 auto;
  padding-left:max(16px,env(safe-area-inset-left,0px));
  padding-right:max(16px,env(safe-area-inset-right,0px));
  padding-block:2.25rem 4rem}
h1,h2,h3{margin:0;font-family:var(--font-display);font-weight:600;text-wrap:balance;
  letter-spacing:-.01em}
p{margin:0}
button,input{font:inherit;color:inherit}

/* masthead */
.masthead{display:flex;flex-wrap:wrap;gap:1rem 1.5rem;align-items:flex-end;
  justify-content:space-between;padding-bottom:1.25rem;border-bottom:1px solid var(--line)}
.eyebrow{font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;
  color:var(--accent);margin-bottom:.35rem}
h1{font-size:clamp(1.7rem,4.6vw,2.3rem)}
.sub{color:var(--fg-dim);font-size:.9rem;margin-top:.3rem;max-width:46ch}

/* tiles */
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px;
  margin-top:1.75rem;background:var(--line-soft);border:1px solid var(--line-soft);
  border-radius:3px;overflow:hidden}
.tile{background:var(--surface);padding:1.05rem 1.15rem;min-width:0}
.tile.lead{background:var(--accent-soft)}
.tile dt{font-size:.68rem;font-weight:600;letter-spacing:.11em;text-transform:uppercase;
  color:var(--fg-dim)}
.tile.lead dt{color:var(--accent-ink)}
.tile dd{margin:.4rem 0 0;font-family:var(--font-mono);font-variant-numeric:tabular-nums;
  font-size:1.3rem;font-weight:500;letter-spacing:-.02em;word-break:break-word}
.tile.lead dd{font-size:1.75rem;color:var(--accent-ink)}
.tile dd .cur{font-size:.72em;color:var(--fg-dim);margin-right:.12em}
.tile.lead dd .cur{color:var(--accent-ink);opacity:.72}

/* status */
.status{margin-top:1.25rem;padding:.7rem .9rem;border-radius:3px;font-size:.85rem;
  border:1px solid var(--line);background:var(--surface);color:var(--fg-dim)}
.status.warn{border-color:var(--danger);background:var(--danger-soft);color:var(--danger)}

/* panels */
.panel{margin-top:2.5rem}
.panel-head{display:flex;flex-wrap:wrap;gap:.5rem 1rem;align-items:baseline;
  justify-content:space-between;margin-bottom:.85rem}
.panel-head h2{font-size:1.12rem}
.note{color:var(--fg-dim);font-size:.82rem;max-width:52ch}
.controls{display:flex;gap:.5rem;align-items:center}
input[type="search"]{background:var(--surface);border:1px solid var(--line);border-radius:3px;
  padding:.4rem .6rem;font-size:.85rem;width:11rem;max-width:45vw}
input[type="search"]:focus-visible,input:focus-visible,button:focus-visible{
  outline:2px solid var(--accent);outline-offset:1px}

/* tables */
.tscroll{overflow-x:auto;border:1px solid var(--line);border-radius:3px;background:var(--surface)}
table{width:100%;border-collapse:collapse;font-size:.875rem;min-width:0}
th,td{padding:.55rem .75rem;text-align:left;white-space:nowrap}
thead th{background:var(--surface-2);font-size:.68rem;font-weight:600;letter-spacing:.09em;
  text-transform:uppercase;color:var(--fg-dim);border-bottom:1px solid var(--line);
  position:sticky;top:0}
th.num,td.num{text-align:right}
td{border-bottom:1px solid var(--line-soft)}
tbody tr:last-child td{border-bottom:0}
.num{font-family:var(--font-mono);font-variant-numeric:tabular-nums}
.sym{font-weight:600;letter-spacing:.02em}
.sortbtn{background:none;border:0;padding:0;margin:0;font:inherit;color:inherit;
  cursor:pointer;display:inline-flex;gap:.3rem;align-items:center;letter-spacing:inherit;
  text-transform:inherit}
.sortbtn .car{opacity:0;font-size:.6rem}
.sortbtn[aria-sort="ascending"] .car,.sortbtn[aria-sort="descending"] .car{opacity:1;color:var(--accent)}
.sortbtn[aria-sort="descending"] .car{transform:rotate(180deg)}
tfoot td{background:var(--surface-2);font-weight:600;border-top:2px solid var(--accent);
  border-bottom:0}
.dim{color:var(--fg-faint)}
.bar{display:block;height:3px;border-radius:2px;background:var(--accent);opacity:.55;
  margin:.3rem 0 0 auto;min-width:1px}
.rowacts{display:flex;gap:.3rem;justify-content:flex-end}
.mini{background:none;border:1px solid var(--line);border-radius:3px;padding:.15rem .45rem;
  font-size:.72rem;color:var(--fg-dim);cursor:pointer}
.mini:hover{border-color:var(--accent);color:var(--accent)}
.mini.armed{border-color:var(--danger);color:var(--danger);background:var(--danger-soft)}

/* empty */
.empty{border:1px dashed var(--line);border-radius:3px;background:var(--surface);
  padding:1.75rem 1.25rem;text-align:center}
.empty h3{font-size:1rem;margin-bottom:.35rem}

/* form */
.form-panel{border:1px solid var(--line);border-radius:3px;background:var(--surface);
  padding:1.15rem 1.25rem 1.3rem}
.form-panel h2{font-size:1rem;margin-bottom:.9rem}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:.8rem}
.field{display:flex;flex-direction:column;gap:.3rem;min-width:0}
.field label{font-size:.68rem;font-weight:600;letter-spacing:.09em;text-transform:uppercase;
  color:var(--fg-dim)}
.field input{background:var(--field);border:1px solid var(--line);border-radius:3px;
  padding:.45rem .55rem;font-size:.9rem;width:100%}
.field input.num{font-family:var(--font-mono)}
.formfoot{display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;margin-top:1rem}
.btn{background:var(--accent);color:var(--btn-fg);border:1px solid var(--accent);
  border-radius:3px;padding:.45rem 1rem;font-size:.87rem;font-weight:500;cursor:pointer}
.btn[disabled]{opacity:.55;cursor:default}
.btn.ghost{background:none;color:var(--fg-dim);border-color:var(--line);font-weight:400}
.btn.ghost:hover{color:var(--accent);border-color:var(--accent)}
.btn.danger{background:var(--danger-soft);color:var(--danger);border-color:var(--danger);
  font-weight:500}
.mh-acts{display:flex;flex-wrap:wrap;gap:.5rem}
.empty-cta{margin-top:1.1rem}
.empty-cta .btn{display:inline-block}
.err{color:var(--danger);font-size:.82rem}
.ro{margin-top:1.75rem;font-style:italic}

/* import */
.io-panel{border:1px solid var(--line);border-radius:3px;background:var(--surface);
  padding:1.15rem 1.25rem 1.3rem}
.io-panel h2{font-size:1rem;margin-bottom:.5rem}
code{font-family:var(--font-mono);font-size:.82em;background:var(--surface-2);
  padding:.1em .35em;border-radius:2px}
.drop{margin-top:.9rem;border:1px dashed var(--line);border-radius:3px;background:var(--field);
  padding:1rem;display:flex;flex-wrap:wrap;gap:.6rem .8rem;align-items:center}
.drop.over{border-color:var(--accent);background:var(--accent-soft)}
.chk{display:flex;gap:.4rem;align-items:center;font-size:.82rem;color:var(--fg-dim)}
.probs{margin:.5rem 0 0;padding-left:1.1rem;font-size:.82rem;color:var(--danger)}
.probs li{margin-top:.15rem}
#imp-progress{margin-top:.85rem;font-variant-numeric:tabular-nums}
#imp-progress.err{color:var(--danger)}
#imp-progress.good{color:var(--accent)}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;
  clip:rect(0 0 0 0);white-space:nowrap;border:0}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
@media (max-width:520px){
  .tile.lead dd{font-size:1.45rem}
  .panel{margin-top:2rem}
}
</style>
</head>
<body>
<div class="wrap">
  <header class="masthead">
    <div>
      <p class="eyebrow">Holdings</p>
      <h1>Cost Basis Ledger</h1>
      <p class="sub">What each lot cost, and what the book adds up to.</p>
    </div>
    <div class="mh-acts">
      <button id="btn-theme" class="btn ghost" type="button" title="Switch between a white page, a dark page, or whatever this computer uses">Theme: System</button>
      <button id="btn-clear" class="btn ghost" hidden>Clear data</button>
      <button id="btn-csv" class="btn ghost" hidden>Export CSV</button>
    </div>
  </header>

  <dl class="tiles">
    <div class="tile lead"><dt>Total cost basis</dt><dd id="s-cost"><span class="cur">$</span>—</dd></div>
    <div class="tile"><dt>Shares</dt><dd id="s-shares">—</dd></div>
    <div class="tile"><dt>Positions</dt><dd id="s-pos">—</dd></div>
    <div class="tile"><dt>Lots</dt><dd id="s-lots">—</dd></div>
  </dl>

  <div id="status" class="status">Loading your entries…</div>

  <section class="panel">
    <div class="panel-head">
      <h2>Positions</h2>
      <p class="note">One row per symbol, rolled up from the lots below.</p>
    </div>
    <div class="tscroll">
      <table id="t-pos">
        <thead><tr>
          <th><button class="sortbtn" data-k="symbol">Symbol <span class="car">▲</span></button></th>
          <th class="num"><button class="sortbtn" data-k="shares">Shares <span class="car">▲</span></button></th>
          <th class="num"><button class="sortbtn" data-k="avg">Avg cost <span class="car">▲</span></button></th>
          <th class="num"><button class="sortbtn" data-k="cost">Cost basis <span class="car">▲</span></button></th>
          <th class="num"><button class="sortbtn" data-k="pct">% of book <span class="car">▲</span></button></th>
        </tr></thead>
        <tbody id="b-pos"></tbody>
        <tfoot id="f-pos"></tfoot>
      </table>
    </div>
  </section>

  <section class="panel">
    <div class="panel-head">
      <h2>Lots</h2>
      <div class="controls">
        <label class="sr-only" for="filter">Filter by symbol</label>
        <input id="filter" type="search" placeholder="Filter symbol…" autocomplete="off">
      </div>
    </div>
    <div class="tscroll" id="lots-wrap">
      <table id="t-lots">
        <thead><tr>
          <th><button class="sortbtn" data-k="symbol">Symbol <span class="car">▲</span></button></th>
          <th><button class="sortbtn" data-k="date">Buy date <span class="car">▲</span></button></th>
          <th class="num"><button class="sortbtn" data-k="shares">Shares <span class="car">▲</span></button></th>
          <th class="num"><button class="sortbtn" data-k="cps">Cost / share <span class="car">▲</span></button></th>
          <th class="num"><button class="sortbtn" data-k="cost">Cost basis <span class="car">▲</span></button></th>
          <th class="num"><button class="sortbtn" data-k="days">Days held <span class="car">▲</span></button></th>
          <th class="num" id="acts-head"></th>
        </tr></thead>
        <tbody id="b-lots"></tbody>
        <tfoot id="f-lots"></tfoot>
      </table>
    </div>
    <div id="empty" class="empty" hidden>
      <h3 id="empty-title">Nothing loaded yet</h3>
      <p class="note" id="empty-body" style="margin:0 auto">Import a CSV of your lots to see positions and totals. You can also type entries in by hand below.</p>
      <p class="empty-cta" id="empty-cta"><label for="file" class="btn">Import a CSV</label></p>
      <p class="empty-cta" id="empty-filter" hidden><button type="button" class="btn" id="btn-showall">Show all lots</button></p>
    </div>
  </section>

  <section class="panel form-panel" id="form-panel" hidden>
    <h2 id="form-title">Add a lot</h2>
    <form id="form" novalidate>
      <div class="grid">
        <div class="field">
          <label for="f-symbol">Symbol</label>
          <input id="f-symbol" name="symbol" type="text" maxlength="12" autocomplete="off" spellcheck="false" placeholder="SCHD">
        </div>
        <div class="field">
          <label for="f-date">Buy date</label>
          <input id="f-date" name="date" type="date">
        </div>
        <div class="field">
          <label for="f-shares">Shares</label>
          <input id="f-shares" name="shares" class="num" type="number" step="any" min="0" inputmode="decimal" placeholder="100">
        </div>
        <div class="field">
          <label for="f-cost">Cost / share</label>
          <input id="f-cost" name="cost" class="num" type="number" step="any" min="0" inputmode="decimal" placeholder="33.94">
        </div>
      </div>
      <div class="formfoot">
        <button type="submit" class="btn" id="f-submit">Add lot</button>
        <button type="button" class="btn ghost" id="f-cancel" hidden>Cancel</button>
        <span class="err" id="f-err" hidden></span>
      </div>
    </form>
  </section>

  <section class="panel io-panel" id="io-panel" hidden>
    <h2>Import lots from a CSV</h2>
    <p class="note">The file needs a header row with these four columns and nothing else:
      <code>Symbol</code>, <code>Buy Date</code>, <code>Shares</code>,
      <code>Cost per Share</code>. Dates read as MM/DD/YYYY or YYYY-MM-DD; leave the cell
      empty for a lot with no date. Export CSV writes this exact shape, so a file from here
      imports straight back.</p>
    <div class="drop" id="drop">
      <input id="file" type="file" accept=".csv,text/csv,text/plain" class="sr-only">
      <label for="file" class="btn ghost">Choose a CSV file</label>
      <span class="note" id="drop-hint">or drop one here</span>
    </div>
    <div id="imp-report" hidden></div>
    <div class="formfoot" id="imp-actions" hidden>
      <button type="button" class="btn" id="imp-go">Import</button>
      <button type="button" class="btn ghost" id="imp-cancel">Cancel</button>
      <label class="chk" for="imp-replace">
        <input type="checkbox" id="imp-replace"> Replace all existing lots
      </label>
    </div>
    <p id="imp-progress" class="note" hidden></p>
  </section>

  <p class="note ro">Your CSV is the record. This page keeps a working copy in this browser so a reload loses nothing, but it never writes back into the file — export when you are done.</p>

</div>

<script>
(function(){
  "use strict";
  var COL = "lots";
  var db = null, downloads = null, canWrite = null;
  var lots = [], ready = false, editId = null, armed = null;
  var clearArmed = false, clearTimer = null;
  var sortPos = { k:"cost", dir:"desc" };
  var sortLot = { k:"symbol", dir:"asc" };
  var filter = "";

  var $ = function(id){ return document.getElementById(id); };
  var money = new Intl.NumberFormat("en-US",{minimumFractionDigits:2,maximumFractionDigits:2});
  var price = new Intl.NumberFormat("en-US",{minimumFractionDigits:2,maximumFractionDigits:4});
  var qty   = new Intl.NumberFormat("en-US",{maximumFractionDigits:4});
  var pctf  = new Intl.NumberFormat("en-US",{style:"percent",minimumFractionDigits:2,maximumFractionDigits:2});

  function num(v){ var n = typeof v === "number" ? v : parseFloat(v); return isFinite(n) ? n : 0; }
  function basis(l){ return num(l.shares) * num(l.cost); }
  function fmtDate(iso){
    if (!iso || typeof iso !== "string") return "";
    var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso);
    return m ? m[2] + "/" + m[3] + "/" + m[1] : iso;
  }
  /* Whole days between the buy date and today. Both ends are taken as UTC
     midnight so a daylight-saving shift can't move the count by a day.
     Returns null when the lot has no date. */
  function daysHeld(iso){
    var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(iso || ""));
    if (!m) return null;
    var buy = Date.UTC(+m[1], +m[2] - 1, +m[3]);
    var n = new Date();
    var today = Date.UTC(n.getFullYear(), n.getMonth(), n.getDate());
    return Math.round((today - buy) / 86400000);
  }

  function cell(row, text, cls){
    var td = document.createElement("td");
    if (cls) td.className = cls;
    td.textContent = text;
    row.appendChild(td);
    return td;
  }
  function setStat(id, value, currency){
    var dd = $(id);
    dd.textContent = "";
    if (currency){
      var s = document.createElement("span");
      s.className = "cur"; s.textContent = "$";
      dd.appendChild(s);
    }
    dd.appendChild(document.createTextNode(value));
  }
  function status(msg, warn){
    var el = $("status");
    if (!msg){ el.hidden = true; return; }
    el.textContent = msg;
    el.className = "status" + (warn ? " warn" : "");
    el.hidden = false;
  }

  /* ---------- derive ---------- */
  function positions(){
    var map = Object.create(null);
    lots.forEach(function(l){
      var s = String(l.symbol || "").toUpperCase();
      if (!s) return;
      var p = map[s] || (map[s] = { symbol:s, shares:0, cost:0, n:0 });
      p.shares += num(l.shares);
      p.cost += basis(l);
      p.n += 1;
    });
    var out = Object.keys(map).map(function(k){ return map[k]; });
    var total = out.reduce(function(a,p){ return a + p.cost; }, 0);
    out.forEach(function(p){
      p.avg = p.shares ? p.cost / p.shares : 0;
      p.pct = total ? p.cost / total : 0;
    });
    return out;
  }
  function sorted(arr, s, keyOf){
    var c = arr.slice();
    c.sort(function(a,b){
      var x = keyOf(a, s.k), y = keyOf(b, s.k), r;
      if (typeof x === "string" || typeof y === "string"){
        r = String(x).localeCompare(String(y));
      } else {
        r = (x < y) ? -1 : (x > y) ? 1 : 0;
      }
      if (r === 0 && s.k !== "symbol"){
        r = String(a.symbol).localeCompare(String(b.symbol));
      }
      return s.dir === "desc" ? -r : r;
    });
    return c;
  }

  /* ---------- render ---------- */
  function render(){
    var pos = positions();
    var totalCost = pos.reduce(function(a,p){ return a + p.cost; }, 0);
    var totalShares = lots.reduce(function(a,l){ return a + num(l.shares); }, 0);

    setStat("s-cost", money.format(totalCost), true);
    setStat("s-shares", qty.format(totalShares));
    setStat("s-pos", String(pos.length));
    setStat("s-lots", String(lots.length));

    /* positions */
    var bp = $("b-pos"); bp.textContent = "";
    sorted(pos, sortPos, function(p,k){ return k === "symbol" ? p.symbol : p[k]; })
      .forEach(function(p){
        var tr = document.createElement("tr");
        cell(tr, p.symbol, "sym");
        cell(tr, qty.format(p.shares), "num");
        cell(tr, price.format(p.avg), "num");
        cell(tr, money.format(p.cost), "num");
        var td = cell(tr, pctf.format(p.pct), "num");
        var bar = document.createElement("span");
        bar.className = "bar";
        bar.style.width = Math.max(1, Math.round(p.pct * 100)) + "%";
        td.appendChild(bar);
        bp.appendChild(tr);
      });
    var fp = $("f-pos"); fp.textContent = "";
    if (pos.length){
      var ftr = document.createElement("tr");
      cell(ftr, "Total");
      cell(ftr, qty.format(totalShares), "num");
      cell(ftr, "", "num");
      cell(ftr, money.format(totalCost), "num");
      cell(ftr, pctf.format(totalCost ? 1 : 0), "num");
      fp.appendChild(ftr);
    }

    /* lots */
    var f = filter.trim().toUpperCase();
    var shown = f ? lots.filter(function(l){
      return String(l.symbol || "").toUpperCase().indexOf(f) === 0;
    }) : lots;

    var bl = $("b-lots"); bl.textContent = "";
    sorted(shown, sortLot, function(l,k){
      if (k === "symbol") return String(l.symbol || "");
      if (k === "date")   return String(l.date || "");
      if (k === "shares") return num(l.shares);
      if (k === "cps")    return num(l.cost);
      if (k === "days"){
        var dh = daysHeld(l.date);
        return dh === null ? -Infinity : dh;
      }
      return basis(l);
    }).forEach(function(l){
