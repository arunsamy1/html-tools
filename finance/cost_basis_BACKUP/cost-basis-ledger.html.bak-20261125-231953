    runQueue(dels, 4).then(function(fails){
      b.disabled = false;
      var gone = ids.length - fails;
      prog(fails
        ? "Cleared " + gone + " of " + ids.length + "; " + fails + " couldn't be removed."
        : "Cleared " + gone + (gone === 1 ? " lot." : " lots."), fails ? "err" : "good");
    });
