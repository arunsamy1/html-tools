  /* ---------- offline storage ----------
     A stand-in for the hosted store, exposing just the calls the page above
     makes (collection().add / doc().set / doc().delete / onSnapshot) and
     keeping the rows in this browser's localStorage. */
  var SEED = [];
  var STORE_KEY = "cost-basis-ledger/lots/v1";
  var persistent = true;

  function makeLocalDB(seedRows){
    var rows = null, listeners = [], queued = false;

    function load(){
      if (rows) return rows;
      var raw = null;
      try { raw = window.localStorage.getItem(STORE_KEY); }
      catch (e){ persistent = false; }
      if (raw){
        try {
          var p = JSON.parse(raw);
          if (p && p.length !== undefined) rows = p;
        } catch (e){ rows = null; }
      }
      if (!rows){ rows = seedRows.slice(); persist(); }
      return rows;
    }
    function persist(){
      try { window.localStorage.setItem(STORE_KEY, JSON.stringify(rows)); }
      catch (e){ persistent = false; }
    }
    function snapshot(){
      var docs = rows.map(function(r){
        return {
          id: r.id, exists: true,
          data: function(){ return r; },
          metadata: { fromCache:false, hasPendingWrites:false }
        };
      });
      return {
        docs: docs, size: docs.length, empty: !docs.length,
        docChanges: function(){ return []; },
        metadata: { fromCache:false, hasPendingWrites:false }
      };
    }
    /* Coalesce a burst of writes (an import) into one re-render. */
    function emit(){
      if (queued) return;
      queued = true;
      setTimeout(function(){
        queued = false;
        var s = snapshot();
        listeners.slice().forEach(function(fn){ fn(s); });
      }, 0);
    }
    function uid(){
      return "l" + Date.now().toString(36) +
        Math.random().toString(36).slice(2, 8);
    }
    function find(id){
      for (var i = 0; i < rows.length; i++){ if (rows[i].id === id) return i; }
      return -1;
    }
    function copy(id, body){
      return { id:id, symbol:body.symbol, date:body.date,
               shares:body.shares, cost:body.cost };
    }

    var api = {
      add: function(body){
        load();
        var rec = copy(uid(), body);
        rows.push(rec); persist(); emit();
        return Promise.resolve({ id: rec.id });
      },
      doc: function(id){
        return {
          set: function(body){
            load();
            var i = find(id);
            if (i < 0) rows.push(copy(id, body)); else rows[i] = copy(id, body);
            persist(); emit();
            return Promise.resolve();
          },
          "delete": function(){
            load();
            var i = find(id);
            if (i >= 0) rows.splice(i, 1);
            persist(); emit();
            return Promise.resolve();
          }
        };
      },
      onSnapshot: function(next){
        listeners.push(next);
        load(); emit();
        return function(){
          listeners = listeners.filter(function(f){ return f !== next; });
        };
      }
    };
    return { collection: function(){ return api; } };
  }

  /* ---------- boot (offline) ---------- */
  db = makeLocalDB(SEED);
  canWrite = true;
  $("form-panel").hidden = false;
  $("io-panel").hidden = false;

  downloads = {
    save: function(req){
      return new Promise(function(resolve, reject){
        try {
          var blob = new Blob([req.data], { type:"text/csv;charset=utf-8" });
          var url = URL.createObjectURL(blob);
          var a = document.createElement("a");
          a.href = url;
          a.download = req.filename;
          a.style.display = "none";
          document.body.appendChild(a);
          a.click();
          setTimeout(function(){
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
          }, 0);
          resolve({ status:"saved" });
        } catch (e){
          reject({ code:"unavailable", message:String(e && e.message || e) });
        }
      });
    }
  };
  $("btn-csv").hidden = false;

  db.collection(COL).onSnapshot(function(snap){
    lots = snap.docs.map(function(doc){
      var v = doc.data() || {};
      return {
        id: doc.id,
        symbol: String(v.symbol == null ? "" : v.symbol),
        date: String(v.date == null ? "" : v.date),
        shares: num(v.shares),
        cost: num(v.cost)
      };
    });
    ready = true;
    status(persistent ? "" :
      "This browser isn't allowing the page to save anything, so changes will " +
      "be lost when you close the tab. Use Export CSV to keep your work.", true);
    render();
  });
})();
</script>
</body>
</html>
